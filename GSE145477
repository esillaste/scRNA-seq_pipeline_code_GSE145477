# ============================================================
# 2) Read self-contained matrix (gene col + barcode header)
# ============================================================
read_counts_selfcontained <- function(mat_path) {
  df <- data.table::fread(mat_path, header = TRUE, data.table = FALSE, check.names = FALSE)
  if (ncol(df) < 2) stop("Unexpected format for: ", basename(mat_path))

  gene_names <- as.character(df[[1]])
  mat_df <- df[, -1, drop = FALSE]

  mat_num <- as.matrix(sapply(mat_df, function(x) as.numeric(x)))
  rownames(mat_num) <- make.unique(gene_names)
  colnames(mat_num) <- colnames(mat_df)

  Matrix::Matrix(mat_num, sparse = TRUE)
}

# ============================================================
# 3) QC + SCTransform per sample
# ============================================================
compute_qc_thresholds <- function(obj,
                                 mito_max = 20,
                                 min_features = 200,
                                 min_counts = 500,
                                 max_features_quantile = 0.99,
                                 max_counts_quantile = 0.99) {
  md <- obj@meta.data
  list(
    min_features = min_features,
    min_counts   = min_counts,
    mito_max     = mito_max,
    max_features = as.numeric(quantile(md$nFeature_RNA, probs = max_features_quantile, na.rm = TRUE)),
    max_counts   = as.numeric(quantile(md$nCount_RNA,   probs = max_counts_quantile,   na.rm = TRUE))
  )
}

apply_qc <- function(obj, thr) {
  subset(
    obj,
    subset =
      nFeature_RNA >= thr$min_features &
      nCount_RNA   >= thr$min_counts &
      percent.mt   <= thr$mito_max &
      nFeature_RNA <= thr$max_features &
      nCount_RNA   <= thr$max_counts
  )
}

preprocess_sample <- function(counts, sample_id, age,
                              mito_pattern = "^mt-",
                              vars_to_regress = c("percent.mt")) {

  obj <- CreateSeuratObject(counts = counts, project = sample_id, min.cells = 3, min.features = 200)
  obj <- RenameCells(obj, add.cell.id = sample_id)  # globally unique barcodes

  obj$sample_id <- sample_id
  obj$age_group <- age

  obj[["percent.mt"]]   <- PercentageFeatureSet(obj, pattern = mito_pattern)
  obj[["percent.ribo"]] <- PercentageFeatureSet(obj, pattern = "^Rpl|^Rps")

  thr <- compute_qc_thresholds(obj)
  obj <- apply_qc(obj, thr)

  obj <- SCTransform(
    obj,
    assay = "RNA",
    vars.to.regress = vars_to_regress,
    method = "glmGamPoi",
    verbose = FALSE
  )

  obj
}

