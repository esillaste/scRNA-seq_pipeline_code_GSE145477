  Adipogenic    = c("Pparg","Cebpa","Lpl","Fabp4","Adipoq"),
  MALP          = c("Adipoq","Lpl","Fabp4","Pparg","Cxcl12","Lepr","Kitl","Apoe"),

  # --- Vascular / mural
  Pericyte      = c("Rgs5","Pdgfrb","Cspg4","Mcam","Des","Acta2"),
  SmoothMuscle  = c("Acta2","Tagln","Myh11","Cnn1"),
  Endothelial   = c("Pecam1","Kdr","Vwf","Emcn","Kdr","Robo4"),

