invisible(lapply(pkgs, library, character.only = TRUE))

if (!requireNamespace("BiocManager", quietly = TRUE)) install.packages("BiocManager")
if (!requireNamespace("glmGamPoi", quietly = TRUE)) BiocManager::install("glmGamPoi", ask = FALSE, update = FALSE)

options(future.globals.maxSize = 10 * 1024^3)  # 10 GB
future::plan("sequential")

# ---------------- Paths ----------------
data_dir <- "C:/Users/esillaste/Downloads/GSE145477_RAW"
out_dir  <- file.path(data_dir, "outputs_seurat")

dir.create(out_dir, recursive = TRUE, showWarnings = FALSE)
dir.create(file.path(out_dir, "qc"), showWarnings = FALSE)
dir.create(file.path(out_dir, "objs"), showWarnings = FALSE)
