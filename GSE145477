dir.create(file.path(out_dir, "tables"), showWarnings = FALSE)

dataset <- "GSE145477"

# ============================================================
# 1) Locate matrix files + infer age
# ============================================================
mat_files <- list.files(data_dir, pattern = "_matrix\\.txt\\.gz$", full.names = TRUE, ignore.case = TRUE)
if (length(mat_files) == 0) stop("No *_matrix.txt.gz files found in: ", data_dir)

infer_age <- function(path) {
  nm <- tolower(basename(path))
  if (grepl("16m", nm)) return("16M")
  if (grepl("1\\.5m", nm) || grepl("1_5m", nm)) return("1.5M")
  if (grepl("3m", nm) && !grepl("16m", nm)) return("3M")
  if (grepl("1m", nm) && !grepl("1\\.5m", nm) && !grepl("1_5m", nm) && !grepl("16m", nm)) return("1M")
  NA_character_
}

manifest <- data.frame(matrix = mat_files, age = sapply(mat_files, infer_age), stringsAsFactors = FALSE)
if (any(is.na(manifest$age))) {
  stop("Could not infer age for:\n", paste(basename(manifest$matrix[is.na(manifest$age)]), collapse = "\n"))
}
manifest <- manifest %>% dplyr::arrange(factor(age, levels = c("1M","1.5M","3M","16M")))
message("Found matrix files:\n", paste(basename(manifest$matrix), collapse = "\n"))

# ============================================================
# 2) Read self-contained matrix (gene col + barcode header)
# ============================================================
read_counts_selfcontained <- function(mat_path) {
  df <- data.table::fread(mat_path, header = TRUE, data.table = FALSE, check.names = FALSE)
  if (ncol(df) < 2) stop("Unexpected format for: ", basename(mat_path))

  gene_names <- as.character(df[[1]])
  mat_df <- df[, -1, drop = FALSE]

  mat_num <- as.matrix(sapply(mat_df, function(x) as.numeric(x)))
  rownames(mat_num) <- make.unique(gene_names)
  colnames(mat_num) <- colnames(mat_df)

  Matrix::Matrix(mat_num, sparse = TRUE)
}

# ============================================================
# 3) QC + SCTransform per sample
# ============================================================
compute_qc_thresholds <- function(obj,
                                 mito_max = 20,
                                 min_features = 200,
                                 min_counts = 500,
                                 max_features_quantile = 0.99,
                                 max_counts_quantile = 0.99) {
  md <- obj@meta.data
  list(
    min_features = min_features,
    min_counts   = min_counts,
    mito_max     = mito_max,
    max_features = as.numeric(quantile(md$nFeature_RNA, probs = max_features_quantile, na.rm = TRUE)),
    max_counts   = as.numeric(quantile(md$nCount_RNA,   probs = max_counts_quantile,   na.rm = TRUE))
  )
}

apply_qc <- function(obj, thr) {
  subset(
    obj,
    subset =
      nFeature_RNA >= thr$min_features &
      nCount_RNA   >= thr$min_counts &
      percent.mt   <= thr$mito_max &
      nFeature_RNA <= thr$max_features &
      nCount_RNA   <= thr$max_counts
  )
}

preprocess_sample <- function(counts, sample_id, age,
                              mito_pattern = "^mt-",
                              vars_to_regress = c("percent.mt")) {

  obj <- CreateSeuratObject(counts = counts, project = sample_id, min.cells = 3, min.features = 200)
  obj <- RenameCells(obj, add.cell.id = sample_id)  # globally unique barcodes

  obj$sample_id <- sample_id
  obj$age_group <- age

  obj[["percent.mt"]]   <- PercentageFeatureSet(obj, pattern = mito_pattern)
  obj[["percent.ribo"]] <- PercentageFeatureSet(obj, pattern = "^Rpl|^Rps")

  thr <- compute_qc_thresholds(obj)
  obj <- apply_qc(obj, thr)

  obj <- SCTransform(
    obj,
    assay = "RNA",
    vars.to.regress = vars_to_regress,
    method = "glmGamPoi",
    verbose = FALSE
  )

  obj
}

obj_list <- list()

for (i in seq_len(nrow(manifest))) {
  age <- manifest$age[i]
  mat_path <- manifest$matrix[i]
  sample_id <- paste0(dataset, "_", age)

  message("\nLoading + preprocessing ", sample_id, " ...")
  counts <- read_counts_selfcontained(mat_path)
  obj <- preprocess_sample(counts, sample_id = sample_id, age = age)

  p_qc <- VlnPlot(obj, features = c("nFeature_RNA","nCount_RNA","percent.mt"), ncol = 3, pt.size = 0.1) +
    patchwork::plot_annotation(title = sample_id)
  ggsave(file.path(out_dir, "qc", paste0("QC_vln_", sample_id, ".png")), p_qc, width = 12, height = 4, dpi = 300)

  obj_list[[sample_id]] <- obj
}
if (length(obj_list) < 2) stop("Need at least 2 samples to integrate; found: ", length(obj_list))

# ============================================================
# 4) SCT anchor-based RPCA integration
# ============================================================
dims_use <- 1:30
nfeatures_use <- 3000
resolution_use <- 0.4

features <- SelectIntegrationFeatures(object.list = obj_list, nfeatures = nfeatures_use)
obj_list <- PrepSCTIntegration(object.list = obj_list, anchor.features = features, verbose = FALSE)

# RPCA requires PCA per object
obj_list <- lapply(obj_list, function(x) RunPCA(x, features = features, npcs = max(dims_use), verbose = FALSE))

anchors <- FindIntegrationAnchors(
  object.list = obj_list,
  normalization.method = "SCT",
  anchor.features = features,
  reduction = "rpca",
  dims = dims_use
)

obj <- IntegrateData(anchorset = anchors, normalization.method = "SCT", dims = dims_use)

# ============================================================
# 5) PCA -> neighbors -> clusters -> UMAP
# ============================================================
DefaultAssay(obj) <- "integrated"
obj <- RunPCA(obj, npcs = max(dims_use), verbose = FALSE)

# kNN/SNN is REQUIRED for clustering; recommended before UMAP
obj <- FindNeighbors(obj, reduction = "pca", dims = dims_use, verbose = FALSE)
obj <- FindClusters(obj, resolution = resolution_use, verbose = FALSE)
obj <- RunUMAP(obj, reduction = "pca", dims = dims_use, verbose = FALSE)

saveRDS(obj, file.path(out_dir, "objs", "GSE145477_integrated_seurat.rds"))

# UMAPs
p_umap_clusters <- DimPlot(obj, reduction = "umap", group.by = "seurat_clusters", label = TRUE) + NoLegend()
ggsave(file.path(out_dir, "figs", "UMAP_clusters.png"), p_umap_clusters, width = 7, height = 6, dpi = 300)

p_umap_age <- DimPlot(obj, reduction = "umap", group.by = "age_group")
ggsave(file.path(out_dir, "figs", "UMAP_age_group.png"), p_umap_age, width = 7, height = 6, dpi = 300)

p_umap_age_split <- DimPlot(obj, reduction = "umap", split.by = "age_group")
ggsave(file.path(out_dir, "figs", "UMAP_split_by_age_group.png"), p_umap_age_split, width = 12, height = 6, dpi = 300)

# ============================================================
# 6) Markers per cluster (SCT) – helpful to validate annotation
# ============================================================
Idents(obj) <- "seurat_clusters"
DefaultAssay(obj) <- "SCT"
obj <- PrepSCTFindMarkers(obj)

markers <- FindAllMarkers(obj, only.pos = TRUE, min.pct = 0.25, logfc.threshold = 0.25)
data.table::fwrite(markers, file.path(out_dir, "tables", "cluster_markers_FindAllMarkers.csv"))

# ============================================================
# 7) Canonical cell-type scoring + auto annotation
#
# We cover (major expected marrow/bone-associated types):
#   - Mesenchymal/SSPC/MSC-like stromal (Lepr/Cxcl12/Pdgfra/Ly6a)
#   - Osteoprogenitor / osteoblast lineage
#   - Osteocyte (often rare/absent in marrow preps, but included to confirm)
#   - Adipogenic + MALP-like (Adipoq/Lpl/Fabp4 + niche genes)
#   - Pericyte/mural + smooth muscle
#   - Endothelial
#   - Osteoclast (myeloid lineage; if present in dataset)
#   - Myeloid / monocyte-macrophage, neutrophil, dendritic
#   - B cell, T/NK cell, plasma cell
#   - HSPC/progenitors
#   - Erythroid
#   - Megakaryocyte
# ============================================================

# Score using RNA log-normalized data
DefaultAssay(obj) <- "RNA"
obj <- NormalizeData(obj, normalization.method = "LogNormalize", scale.factor = 1e4, verbose = FALSE)

gene_sets_raw <- list(
