infer_age <- function(path) {
  nm <- tolower(basename(path))
  if (grepl("16m", nm)) return("16M")
  if (grepl("1\\.5m", nm) || grepl("1_5m", nm)) return("1.5M")
  if (grepl("3m", nm) && !grepl("16m", nm)) return("3M")
  if (grepl("1m", nm) && !grepl("1\\.5m", nm) && !grepl("1_5m", nm) && !grepl("16m", nm)) return("1M")
  NA_character_
}

