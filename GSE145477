anchors <- FindIntegrationAnchors(
  object.list = obj_list,
  normalization.method = "SCT",
  anchor.features = features,
  reduction = "rpca",
  dims = dims_use
)

obj <- IntegrateData(anchorset = anchors, normalization.method = "SCT", dims = dims_use)

# ============================================================
# 5) PCA -> neighbors -> clusters -> UMAP
# ============================================================
DefaultAssay(obj) <- "integrated"
obj <- RunPCA(obj, npcs = max(dims_use), verbose = FALSE)

obj <- FindNeighbors(obj, reduction = "pca", dims = dims_use, verbose = FALSE)
obj <- FindClusters(obj, resolution = resolution_use, verbose = FALSE)
obj <- RunUMAP(obj, reduction = "pca", dims = dims_use, verbose = FALSE)

