# ============================================================
# GSE145477 (bone marrow mesenchymal lineage / MALP paper) – Seurat v5 pipeline
# Windows-safe, self-contained matrix .txt.gz (gene column + barcode header)
#
# GOAL:
#   - Integrate ages (1M, 1.5M, 3M, 16M)
#   - Cluster + UMAP
#   - Canonical marker scoring to annotate major marrow/bone lineages
#   - Klb expression: FeaturePlot/VlnPlot/DotPlot + summary tables
#
# INPUT files like:
#   GSM4318799_1M_matrix.txt.gz
# containing:
#   - header row = cell barcodes
#   - first column = gene names
#   - remaining columns = raw counts
#
# OUTPUT:
#   outputs_seurat/qc, figs, tables, objs
#
# NOTE ON kNN before UMAP:
#   - kNN/SNN (FindNeighbors) is REQUIRED for clustering.
#   - UMAP can run without FindNeighbors, but in Seurat we typically run
#     FindNeighbors + FindClusters first (recommended; also you want clusters anyway).
# ============================================================

options(stringsAsFactors = FALSE)
set.seed(42)

# ---------------- Packages ----------------
pkgs <- c("Seurat", "SeuratObject", "Matrix", "dplyr", "ggplot2", "patchwork", "data.table", "future")
