  Dendritic     = c("Itgax","Flt3","Clec10a","Xcr1","Irf8"),

  # --- Lymphoid
  Bcell         = c("Ms4a1","Cd79a","Cd79b","Cd74","H2-Ab1"),
  Plasma        = c("Jchain","Mzb1","Xbp1","Sdc1"),
  Tcell_NK      = c("Cd3d","Cd3e","Trac","Ltb","Nkg7","Gzmb"),

  # --- HSPC / cycling progenitors
  HSPC          = c("Kit","Lmo2","Gata2","Procr","Ly6a"),
  Cycling       = c("Mki67","Top2a","Tubb5","Pclaf","Cenpf"),

  # --- Erythroid / megakaryocyte
  Erythroid     = c("Hbb-bs","Hbb-bt","Hba-a1","Hba-a2","Alas2"),
  Megakaryocyte = c("Ppbp","Pf4","Nrgp","Itga2b")
)

# Filter to genes present
genes_present <- rownames(obj[["RNA"]])
gene_sets <- lapply(gene_sets_raw, function(gs) unique(gs[gs %in% genes_present]))
gene_sets <- gene_sets[sapply(gene_sets, length) >= 2]  # keep only usable sets

if (length(gene_sets) == 0) stop("All gene sets empty after filtering to present genes. Check feature naming.")

cat("\nGene sets retained for scoring (counts):\n")
print(sapply(gene_sets, length))

# AddModuleScore per gene set (robust: ensures all score columns exist)
score_cols <- character(0)
for (nm in names(gene_sets)) {
  prefix <- paste0(nm, "_Score")
  obj <- AddModuleScore(obj, features = list(gene_sets[[nm]]), name = prefix, assay = "RNA", search = FALSE)
  colnm <- paste0(prefix, "1")
  if (colnm %in% colnames(obj@meta.data)) score_cols <- c(score_cols, colnm)
}

cat("\nScore columns created:\n")
print(score_cols)
if (length(score_cols) < 2) warning("Only ", length(score_cols), " score column(s) created. Annotation will be limited.")

# Cluster-average scores
scores_df <- FetchData(obj, vars = c("seurat_clusters", score_cols))
cluster_scores <- scores_df %>%
  dplyr::group_by(seurat_clusters) %>%
  dplyr::summarise(dplyr::across(dplyr::all_of(score_cols), mean), .groups = "drop")

score_mat <- as.matrix(cluster_scores[, score_cols, drop = FALSE])

# Winner = max scoring program per cluster
winner_col <- apply(score_mat, 1, function(x) colnames(score_mat)[which.max(x)])
winner_set <- gsub("_Score1$", "", winner_col)

# Map to cleaner names
pretty_map <- c(
  MSC_SSPC="MSC/SSPC",
  Osteoprogenitor="Osteoprogenitor",
  Osteoblast="Osteoblast",
  Osteocyte="Osteocyte",
  Adipogenic="Adipogenic",
  MALP="MALP",
  Pericyte="Pericyte/Mural",
  SmoothMuscle="Smooth muscle",
  Endothelial="Endothelial",
  Osteoclast="Osteoclast",
  Myeloid="Myeloid",
  Macrophage="Macrophage",
  Neutrophil="Neutrophil",
  Dendritic="Dendritic",
  Bcell="B cell",
  Plasma="Plasma cell",
  Tcell_NK="T/NK cell",
  HSPC="HSPC",
  Cycling="Cycling",
  Erythroid="Erythroid",
  Megakaryocyte="Megakaryocyte"
)

cluster_scores$auto_label <- winner_set
