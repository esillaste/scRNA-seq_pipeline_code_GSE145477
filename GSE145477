# ---------- helpers ----------
filter_sets <- function(gs_list, genes_present, min_genes = 2) {
  gs <- lapply(gs_list, function(v) unique(v[v %in% genes_present]))
  gs[sapply(gs, length) >= min_genes]
}

add_scores_per_set <- function(obj, gs_list, assay = "RNA") {
  score_cols <- character(0)
  for (nm in names(gs_list)) {
    prefix <- paste0(nm, "_Score")
    obj <- AddModuleScore(obj, features = list(gs_list[[nm]]), name = prefix, assay = assay, search = FALSE)
    colnm <- paste0(prefix, "1")
    if (colnm %in% colnames(obj@meta.data)) score_cols <- c(score_cols, colnm)
  }
  list(obj = obj, score_cols = score_cols)
}

cluster_mean_scores <- function(obj, score_cols) {
  df <- FetchData(obj, vars = c("seurat_clusters", score_cols))
  df %>%
    dplyr::group_by(seurat_clusters) %>%
    dplyr::summarise(dplyr::across(dplyr::all_of(score_cols), mean), .groups = "drop")
}

winner_label <- function(cluster_scores, score_cols) {
  mat <- as.matrix(cluster_scores[, score_cols, drop = FALSE])
  wcol <- apply(mat, 1, function(x) colnames(mat)[which.max(x)])
  gsub("_Score1$", "", wcol)
}

